# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Secrets. Any .env variant (.env.local, ...) except the template.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Data: the PDF is 118 MB (over GitHub's 100 MB limit) and processed files are rebuildable.
data/raw/
data/processed/
*.pdf

# Experiment indexes stay local. The indexes the app offers are committed: Streamlit
# Cloud has no PDF to rebuild them from. The default (settings.index_name) is ~32 MB,
# largest file 23 MB; the structured one (index picker) ~25 MB, largest file 18 MB.
data/index/*
!data/index/fixed-1000-150-header__bge-base/
!data/index/structured-1500__bge-base/

# LLM response cache and the fastembed model (~210 MB, downloaded on first start)
.cache/

# OS / editors
.DS_Store
.idea/
.vscode/

# Claude Code settings: kept local
.claude/

# Project notes for Claude Code: kept local
CLAUDE.md
