# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Gemini model names. Free-tier models change often: check AI Studio for the current ones.
GEMINI_MODEL=
GEMINI_JUDGE_MODEL=
# Thinking for the answer model (Gemini 3+): minimal, low, medium or high. Empty = model default.
GEMINI_THINKING_LEVEL=low
# Writes extra search queries in the Act's wording. Empty = GEMINI_MODEL. Flash-Lite is enough.
GEMINI_EXPAND_MODEL=
# Search with LLM-written queries as well as the question (one extra Gemini call per question)
EXPAND_QUERIES=true

# Local embedding model (fastembed)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Reorder search results with a local cross-encoder (fastembed, ~80 MB, ~2 s per question)
RERANK=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Chat memory: earlier turns used to rewrite a follow-up question (one extra Gemini call
# per follow-up, with GEMINI_EXPAND_MODEL)
HISTORY_TURNS=3

# 1 = show timings, tokens, cache hits, prompts and memory under each answer in the app.
# For local testing only. Never set it in Streamlit Cloud's Secrets.
DEV_MODE=0

# Remove amendment footnotes during cleaning. Set to false only for the ablation run.
STRIP_FOOTNOTES=true

# 1 = fake embeddings and fake LLM (used in CI: no keys, no downloads)
FAKE_MODELS=0
