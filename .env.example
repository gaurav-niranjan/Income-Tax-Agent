# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Gemini model names. Free-tier models change often: check AI Studio for the current ones.
GEMINI_MODEL=
GEMINI_JUDGE_MODEL=

# Local embedding model (fastembed)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Remove amendment footnotes during cleaning. Set to false only for the ablation run.
STRIP_FOOTNOTES=true

# 1 = fake embeddings and fake LLM (used in CI: no keys, no downloads)
FAKE_MODELS=0
